<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/addblog.css" />
  </head>
  <body>
    <%- include("./partials/nav") %>
    <div id="menudiv">
      <h1>Create New Blog Post</h1>
      <a href="/" id="home-ref">Go to home </a>
    </div>
    <main>
      <form action="/blog/addblog" method="post" enctype="multipart/form-data">
        <div class="field">
          <label>Blog Title</label>
          <input
            type="text"
            name="title"
            placeholder="Enter your blog title ..."
          />
        </div>
        <div class="field">
          <label>Blog Content</label>
          <textarea
            name="body"
            placeholder="Write your blog content here ...."
            id="blog-content"
          ></textarea>
        </div>
        <label for="">Cover Image</label>
        <input
          type="file"
          name="coverImg"
          id="custom-file-input"
          class="hidden-file-input"
        />
        <label for="custom-file-input" class="custom-button">
          <div class="upload-img-div" id="custom-file-input">
            <img id="upload-img" src="/Images/image-.png" alt="" />
            <span class="file-name">No file chosen</span>
          </div>
        </label>
        <div class="submit">
          <button id="add" type="submit">Add Blog</button>
          <button id="cancel">
            <a href="/">Cancel</a>
          </button>
        </div>
      </form>
    </main>
  </body>
  <script>
    document
      .getElementById("custom-file-input")
      .addEventListener("change", function () {
        const fileNameSpan = document.querySelector(".file-name");
        if (this.files.length > 0) {
          fileNameSpan.textContent = this.files[0].name;
        } else {
          fileNameSpan.textContent = "No file chosen";
        }
      });
  </script>
</html>
